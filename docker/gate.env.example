# 复制为 gate.env 后填写; 值不要加引号 (docker run --env-file 会把引号当成值的一部分)
# 各变量含义见 entrypoint.sh 开头的注释

# work-tunnel-vless
UUID=
TUNNEL_DOMAIN=vless.example.com
TUNNEL_TOKEN=

# gate
GATE_HOST=gate.example.com
